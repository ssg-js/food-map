# Copy to .env locally. Never commit real values.
DATABASE_URL="postgresql://user:password@localhost:5432/food_map?schema=public"
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
PERSONAL_SETUP_TOKEN=""
AUTH_BASE_URL="http://localhost:3000"
AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Defaults to mock when omitted. Keys below stay unused in mock mode.
EXTERNAL_API_MODE="mock"
API_DAILY_LIMIT="100"
API_MONTHLY_LIMIT="1000"
GOOGLE_PLACES_ENABLED="false"
GOOGLE_MAPS_BROWSER_ENABLED="false"
GOOGLE_PLACES_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MONITORING_ENABLED="false"
GOOGLE_CLOUD_PROJECT=""
