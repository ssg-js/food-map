# Physical devices: use this computer's LAN IP, not localhost.
# iOS simulator: http://127.0.0.1:3000
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Optional, separately restricted native Android Maps SDK key.
# Do not copy the server-side Google Places key here.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=
