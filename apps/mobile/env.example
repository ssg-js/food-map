# API server origin only: no path, query, token, or credentials.
# Release devices must use a public HTTPS server origin.
# Local development only: use this computer's private LAN IP on physical devices.
# iOS simulator: http://127.0.0.1:3000
# Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Maps use the authenticated web server's Google Maps JavaScript API key.
# No native Android Maps SDK key is needed. Never put the server Places key here.
